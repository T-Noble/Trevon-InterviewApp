@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Questions</h1>
    <h4 class="display-6">An Interview App by Trevon Noble</h4>
    <hr />
    <div class="custom-vstack" data-bind="foreach: questions">
        <div class="custom-hstack">
            <span data-bind="attr: { title: Hint },text: Text" style="width: 200px;"></span>
            <button class="btn" id="showAnswerBtn"
                    data-bind="click: toggleAnswer, text: buttonText">
                Show Answer
            </button>

            <div class="btnAnswer">
                <!--Adding span for answer text-->
                <span class="answer" data-bind="text: Answer, visible: showAnswer"></span>
            </div>
            
        </div>
        <hr />
    </div>

    <p class="kudos" >A big thankyou to Dane Barongan for initially reaching out!</p>
</div>

@section pagescripts {
    <script src="~/js/viewModels/question.js"></script>
}